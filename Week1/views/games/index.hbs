<h1>Video Game Library</h1>

{{#if successMessage}}
    <h2 style="color: green;">{{successMessage}}</h2>
{{/if}}

{{#if error}}
    <p class="error">{{error}}</p>
{{/if}}

<section class="card">
    <form action="/games" method="POST">
        <label>
            Title:
            <input name="title" value="{{form.title}}" required>
        </label>
        <label>
            Platform:
            <input name="platform" value="{{form.platform}}" required>
        </label>
        <label>
            Genre:
            <input name="genre" value="{{form.genre}}" required>
        </label>
        <label>
            Rating:
            <input type="number" name="rating" min="0" max="10" value="{{form.rating}}" required>
        </label>
        <label>
            Release Year:
            <input type="number" name="releaseYear" min="1970" max="2100" value="{{form.releaseYear}}" required>
        </label>
        <button type="submit">Create Entry</button>
    </form>
</section>

<section class="card">
    <h2>Game List</h2>
    {{#if games.length}}
        <table>
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Platform</th>
                    <th>Genre</th>
                    <th>Rating</th>
                    <th>Release Year</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#each games}}
                    <tr>
                        <td>{{this.title}}</td>
                        <td>{{this.platform}}</td>
                        <td>{{this.genre}}</td>
                        <td>{{this.rating}}</td>
                        <td>{{this.releaseYear}}</td>
                        <td>
                            <a href="/games/{{this._id}}/edit">Edit</a>

                            <form action="/games/{{this._id}}?_method=DELETE" method="POST" style="display:inline;">
                                <button type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    {{else}}
        <p>No games in the library yet.</p>
    {{/if}}
</section>